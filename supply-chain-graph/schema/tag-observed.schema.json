{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cssc.toddysm.com/schema/tag-observed.schema.json",
  "title": "TagObserved",
  "description": "Append-only observation that a tag pointed to a digest in a repository at a point in time.",
  "type": "object",
  "required": ["schemaVersion", "kind", "recordedAt", "source", "occurrence", "tag", "digest", "observedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "TagObserved" },
    "id": { "$ref": "envelope.schema.json#/$defs/contentHash" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "envelope.schema.json#/$defs/source" },
    "occurrence": {
      "type": "object",
      "description": "The registry + repository the tag lives in (digest is recorded separately as the pointed-to target).",
      "required": ["registry", "repository"],
      "additionalProperties": false,
      "properties": {
        "registry": { "$ref": "envelope.schema.json#/$defs/registry" },
        "repository": { "$ref": "envelope.schema.json#/$defs/repository" }
      }
    },
    "tag": { "type": "string", "minLength": 1 },
    "digest": { "$ref": "envelope.schema.json#/$defs/digest" },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}
